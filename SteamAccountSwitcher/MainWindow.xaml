<Window x:Class="SteamAccountSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SteamAccountSwitcher.Models"
        Title="Steam Account Switcher" Width="1180" Height="760"
        MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="#101110" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" Icon="Assets/app-icon.ico" Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.42"/>
                    <DoubleAnimation Storyboard.TargetName="DashboardShift"
                                     Storyboard.TargetProperty="Y"
                                     From="18" To="0" Duration="0:0:0.48">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Margin="14" CornerRadius="{StaticResource WindowCornerRadius}"
            BorderBrush="#3B3D39" BorderThickness="1"
            Background="#151615" ClipToBounds="True">
        <Grid x:Name="DashboardRoot" RenderTransformOrigin=".5,.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="DashboardShift"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="74"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Compact dashboard rail -->
            <Border Background="#1B1C1B" BorderBrush="#363834" BorderThickness="0,0,1,0">
                <Grid Margin="0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="44" Height="44" CornerRadius="{StaticResource ControlCornerRadius}"
                            BorderBrush="#738535" BorderThickness="1" ClipToBounds="True">
                        <Image Source="Assets/app-icon.png" Stretch="UniformToFill"/>
                    </Border>

                    <Border Grid.Row="1" Width="38" Height="38" CornerRadius="19"
                            Background="#EEEFE9" VerticalAlignment="Top" Margin="0,30,0,0"
                            ToolTip="Accounts dashboard">
                        <TextBlock Text="A" Foreground="#171817" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Button Grid.Row="2" Style="{StaticResource GhostButton}" Width="38" Height="38"
                            Padding="0" Content="⚙" FontSize="15" Click="Settings_Click"
                            ToolTip="Settings"/>
                </Grid>
            </Border>

            <!-- Main dashboard -->
            <Grid Grid.Column="1" Margin="28,20,28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Operational chips -->
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#202020" CornerRadius="14" Padding="11,6" Margin="0,0,7,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#83D89A" Margin="0,0,7,0"/>
                                <TextBlock Text="Steam ready" Foreground="#B0B0AA" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#202020" CornerRadius="14" Padding="11,6" Margin="0,0,7,0">
                            <TextBlock Text="{Binding Accounts.Count, StringFormat={}{0} accounts}"
                                       Foreground="#B0B0AA" FontSize="11"/>
                        </Border>
                        <Border Background="#202020" CornerRadius="14" Padding="11,6">
                            <TextBlock Text="DPAPI protected" Foreground="#B0B0AA" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Page heading -->
                <Grid Grid.Row="1" Margin="0,30,0,0">
                    <StackPanel>
                        <TextBlock Text="ACCOUNT OPERATIONS" Foreground="{StaticResource AccentBrush}"
                                   FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="Steam Accounts" Foreground="{StaticResource TextBrush}"
                                   FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="Switch identities without leaving your dashboard."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="Settings"
                                Click="Settings_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="+  Add account"
                                Click="Add_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Tabs and separators -->
                <Grid Grid.Row="2" Margin="0,28,0,0">
                    <Border VerticalAlignment="Bottom" Height="1" Background="#282828"/>
                    <Border Padding="2,0,2,12" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="0,0,0,2" HorizontalAlignment="Left">
                        <TextBlock Text="ACCOUNT LIST" Foreground="{StaticResource TextBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <!-- Account cards -->
                <Grid Grid.Row="3" Margin="0,24,0,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Accounts}" Margin="7,7,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SteamAccount}">
                                    <Border x:Name="AccountCard" Width="302" Height="218" Margin="0,0,14,14"
                                            Padding="17" CornerRadius="{StaticResource PanelCornerRadius}"
                                            Background="#222321"
                                            BorderBrush="#3B3D39" BorderThickness="1" Cursor="Hand"
                                            MouseLeftButtonUp="AccountCard_Click"
                                            RenderTransformOrigin=".5,.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="CardScale"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4"
                                                              Color="#000000" Opacity=".25"/>
                                        </Border.Effect>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         To="1.025" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         To="1.025" Duration="0:0:0.18"/>
                                                        <ColorAnimation Storyboard.TargetName="AccountCard"
                                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                        To="#66782F" Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         To="1" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         To="1" Duration="0:0:0.2"/>
                                                        <ColorAnimation Storyboard.TargetName="AccountCard"
                                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                        To="#3B3D39" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="51" Height="51">
                                                    <Ellipse Fill="#252525" Stroke="#373737" StrokeThickness="1"/>
                                                    <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Ellipse Width="43" Height="43">
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding AvatarPath}"
                                                                        Stretch="UniformToFill"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <Ellipse Width="47" Height="47"
                                                             Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                                             StrokeDashArray="1 2" Opacity=".72"/>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="12,4,8,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="16"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Username}" Foreground="#A9AAA3"
                                                               FontSize="11" Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Border Grid.Column="2"
                                                        CornerRadius="{StaticResource ControlCornerRadius}" Padding="8,4"
                                                        VerticalAlignment="Top">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Background" Value="#263A2A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="5" Height="5" Fill="#83D89A" Margin="0,0,5,0"/>
                                                        <TextBlock Text="ACTIVE" Foreground="#83D89A"
                                                                   FontSize="8" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Margin="0,15,0,8">
                                                <TextBlock Text="{Binding Description}" Foreground="#C3C4BD"
                                                           TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                                           MaxHeight="38"/>
                                                <Grid Margin="0,13,0,0">
                                                    <Border Height="4" Background="#2A2A2A" CornerRadius="2"/>
                                                    <Border Height="4" Width="112" Background="{StaticResource AccentBrush}"
                                                            CornerRadius="2" HorizontalAlignment="Left"/>
                                                </Grid>
                                            </StackPanel>

                                            <Grid Grid.Row="2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="◈" Foreground="#C5E65C" FontSize="11"
                                                               Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding ModeLabel}" Foreground="#A9AAA3"
                                                               FontSize="9" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource GhostButton}" Padding="9,5"
                                                            Content="Edit" Tag="{Binding}" Click="Edit_Click"
                                                            Margin="0,0,6,0"/>
                                                    <Button Style="{StaticResource GhostButton}" Padding="9,5"
                                                            Content="Remove" Tag="{Binding}" Click="Remove_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Background="#171717" BorderBrush="#2E2E2E" BorderThickness="1"
                            CornerRadius="{StaticResource PanelCornerRadius}" Padding="46">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAccounts}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="76" Height="76" Margin="0,0,0,18">
                                <Ellipse Fill="#202020" Stroke="#353535"/>
                                <Ellipse Width="50" Height="50" Stroke="{StaticResource AccentBrush}"
                                         StrokeThickness="2" StrokeDashArray="2 3"/>
                                <TextBlock Text="+" Foreground="{StaticResource AccentBrush}" FontSize="26"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="No accounts on the board" FontSize="21" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Add a remembered Steam session or an encrypted login."
                                       Foreground="#A9AAA3" FontSize="12" Margin="0,8,0,20"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="+  Add first account"
                                    Click="Add_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Live status -->
                <Border Grid.Row="4" Background="#151515" BorderBrush="#292929" BorderThickness="1"
                        CornerRadius="{StaticResource PanelCornerRadius}" Padding="13,9">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Height="12" Margin="0,0,9,0">
                                <Ellipse x:Name="StatusPulse" Width="11" Height="11"
                                         Fill="{StaticResource AccentBrush}" Opacity=".18">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform CenterX="5.5" CenterY="5.5"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From=".1" To=".45" Duration="0:0:1"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                     From=".7" To="1.2" Duration="0:0:1"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     From=".7" To="1.2" Duration="0:0:1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}"/>
                            </Grid>
                            <TextBlock Text="{Binding Status}" Foreground="#A5A5A0" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar HorizontalAlignment="Right" Width="145" Height="3"
                                     IsIndeterminate="True" Foreground="{StaticResource AccentBrush}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
